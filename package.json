{
  "name": "childrenssudoku-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npm run start",
    "build:web": "cd apps/web && npm run build",
    "install:all": "npm install && cd apps/web && npm install && cd ../.. && cd packages/core && npm install",
    "setup": "npm run install:all"
  }
}